# Agora RTC Configuration
# Get from: Agora Console → your project → App ID / App Certificate
AGORA_APP_ID=your_agora_app_id_here
AGORA_APP_CERTIFICATE=your_agora_app_certificate_here

# Agora Interactive Whiteboard Configuration
# App Identifier: Agora Console → Whiteboard → your project → App Identifier
WHITEBOARD_APP_IDENTIFIER=your_whiteboard_app_identifier_here
# SDK Token: Agora Console → Whiteboard → your project → SDK Token
# ⚠️  Never commit a real SDK Token — it has full API permissions
WHITEBOARD_SDK_TOKEN=your_whiteboard_sdk_token_here
# Region options: us-sv | sg | in | gb-lon | cn-hz
WHITEBOARD_REGION=us-sv

# Supabase
# Project URL and anon/publishable key from: supabase.com → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your_key_here

# App Configuration
# Set to: development | staging | production
APP_ENV=development
APP_NAME=OnlineTeachingApp
